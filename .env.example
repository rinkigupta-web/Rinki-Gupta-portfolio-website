# ========================================================
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ========================================================
# Template for environment variables.
# Real credentials in .env are hidden from GitHub by .gitignore.

# Contact Details
PORTFOLIO_CONTACT_EMAIL="your-email@example.com"
PORTFOLIO_WHATSAPP_NUMBER="91XXXXXXXXXX"

# Social Profile URLs
PORTFOLIO_LINKEDIN_URL="https://www.linkedin.com/in/your-profile/"
PORTFOLIO_BEHANCE_URL="https://www.behance.net/your-profile"
PORTFOLIO_GITHUB_URL="https://github.com/your-username"

# Optional Third-Party Integrations
# GOOGLE_ANALYTICS_MEASUREMENT_ID=""
# EMAILJS_SERVICE_ID=""
# EMAILJS_PUBLIC_KEY=""
